## Backend Implementation Guidelines

### Express.js Server Setup
```javascript
const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');

const app = express();

// Security middleware
app.use(helmet());
app.use(cors({
  origin: process.env.FRONTEND_URL || 'http://localhost:3000',
  credentials: true
}));

// Rate limiting
const limiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 100 // limit each IP to 100 requests per windowMs
});
app.use('/api/', limiter);

// Body parsing middleware
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true }));

// Routes
app.use('/api/auth', authRoutes);
app.use('/api/recipes', recipeRoutes);
app.use('/api/saved-recipes', savedRecipeRoutes);

// Error handling middleware
app.use(errorHandler);
```

### API Route Implementation
```javascript
// Use async/await and proper error handling
const generateRecipes = async (req, res, next) => {
  try {
    // Validate input
    const { ingredients } = req.body;
    if (!ingredients || !Array.isArray(ingredients) || ingredients.length === 0) {
      return res.status(400).json({ 
        error: 'Valid ingredients array is required' 
      });
    }

    // Check cache first
    const cachedRecipe = await checkRecipeCache(ingredients);
    if (cachedRecipe) {
      return res.json({
        success: true,
        data: cachedRecipe,
        cached: true
      });
    }

    // Generate new recipe
    const recipe = await openaiService.generateRecipe(ingredients);
    
    // Cache the result
    await cacheRecipe(ingredients, recipe);
    
    res.json({
      success: true,
      data: recipe,
      cached: false
    });

  } catch (error) {
    console.error('Recipe generation error:', error);
    next(error);
  }
};
```

### Database Operations
```javascript
// Use parameterized queries and proper error handling
const saveRecipe = async (userId, recipeData) => {
  try {
    const { data, error } = await supabase
      .from('saved_recipes')
      .insert({
        user_id: userId,
        title: recipeData.title,
        recipe_data: recipeData,
